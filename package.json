{
  "name": "pi-web-tools",
  "version": "0.1.0",
  "description": "Playwright web fetching, native OpenAI search and Brave/Exa search for pi",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "web-search", "playwright"],
  "engines": { "node": ">=22" },
  "pi": { "extensions": ["./src/index.ts"] },
  "files": ["src", "schemas", "examples", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "browser:install": "playwright install chromium --no-shell"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^27.0.0",
    "playwright": "1.63.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typebox": "^1.0.0"
  }
}
